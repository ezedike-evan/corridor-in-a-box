{
  "name": "@corridor/stellar",
  "version": "0.1.0",
  "description": "Stellar network wiring for the corridor engine: Horizon settlement, SEP-10 signing and the pre-settle gate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezedike-evan/corridor-in-a-box.git",
    "directory": "packages/stellar"
  },
  "bugs": {
    "url": "https://github.com/ezedike-evan/corridor-in-a-box/issues"
  },
  "homepage": "https://github.com/ezedike-evan/corridor-in-a-box#readme",
  "keywords": [
    "stellar",
    "corridor",
    "stellar",
    "horizon",
    "settlement"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./signers/gcp": {
      "types": "./dist/signers/gcp.d.ts",
      "source": "./src/signers/gcp-kms.ts",
      "import": "./dist/signers/gcp.js"
    },
    "./signers/aws": {
      "types": "./dist/signers/aws.d.ts",
      "source": "./src/signers/aws-kms.ts",
      "import": "./dist/signers/aws.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@corridor/types": "workspace:*",
    "@corridor/manifest": "workspace:*",
    "@corridor/engine": "workspace:*",
    "@corridor/sep31": "workspace:*",
    "@stellar/stellar-sdk": "^17.4.0",
    "@corridor/probe": "workspace:*",
    "@corridor/router": "workspace:*"
  }
}
