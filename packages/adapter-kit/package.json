  "description": "Port and helpers for implementing a Stellar anchor adapter: the AnchorAdapter interface, SEP-10 and SEP-12 clients, and a conformance harness.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezedike-evan/corridor-in-a-box.git",
    "directory": "packages/adapter-kit"
  },
  "bugs": {
    "url": "https://github.com/ezedike-evan/corridor-in-a-box/issues"
  },
  "homepage": "https://github.com/ezedike-evan/corridor-in-a-box#readme",
  "keywords": [
    "stellar",
    "corridor",
    "adapter",
    "anchor",
    "sep-10",
    "sep-12"
  ],
  "type": "module",
