{
  "name": "corridor-in-a-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open, manifest-driven engine for Stellar SEP-31 cross-border corridors. A corridor is configuration, not code.",
  "license": "Apache-2.0",
  "author": "ezedike-evan <210902543@live.unilag.edu.ng>",
  "maintainers": [
    "ezedike-evan <210902543@live.unilag.edu.ng>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezedike-evan/corridor-in-a-box.git"
  },
  "bugs": {
    "url": "https://github.com/ezedike-evan/corridor-in-a-box/issues"
  },
  "homepage": "https://github.com/ezedike-evan/corridor-in-a-box#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "check:packages": "pnpm --filter \"./packages/**\" exec ../../node_modules/.bin/publint && pnpm --filter \"./packages/**\" exec ../../node_modules/.bin/attw --pack . --profile esm-only && node scripts/dist-smoke.mjs",
    "test:quarantine": "vitest run --mode quarantine",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "lefthook install",
    "cli": "tsx packages/cli/src/index.ts",
    "example": "tsx examples/run-payment.ts",
    "example:stub": "tsx examples/run-stub-adapter.ts",
    "testnet": "tsx examples/run-testnet.ts",
    "serve": "tsx examples/run-service.ts",
    "verify:settle": "tsx examples/verify-settle-leg.ts",
    "verify:corridor": "tsx examples/verify-corridor.ts",
    "fund:testnet": "tsx examples/fund-testnet-sender.ts",
    "probe:anchor": "tsx examples/probe-anchor.ts",
    "probe:sweep": "tsx examples/sweep-anchors.ts",
    "registry:read": "tsx examples/read-registry.ts",
    "registry:staleness": "tsx examples/check-staleness.ts",
    "registry:history": "tsx examples/registry-history.ts",
    "attest": "tsx examples/attest.ts",
    "gen:web-data": "tsx scripts/gen-web-data.ts",
    "corridors:catalog": "tsx examples/gen-corridor-catalog.ts",
    "sweep:anchors": "tsx examples/sweep-anchors.ts",
    "create:adapter": "tsx scripts/create-adapter.ts",
    "mock:anchor": "tsx examples/run-mock-anchor.ts"
  },
  "dependencies": {
    "@corridor/adapter-kit": "workspace:*",
    "@corridor/attester": "workspace:*",
    "@corridor/engine": "workspace:*",
    "@corridor/manifest": "workspace:*",
    "@corridor/probe": "workspace:*",
    "@corridor/registry": "workspace:*",
    "@corridor/router": "workspace:*",
    "@corridor/sep31": "workspace:*",
    "@corridor/sep6": "workspace:*",
    "@corridor/service": "workspace:*",
    "@corridor/stellar": "workspace:*",
    "@corridor/types": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.200.0",
    "@opentelemetry/sdk-metrics": "2.0.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "2.1.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "2.2.2",
    "parse-prometheus-text-format": "^1.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0"
}